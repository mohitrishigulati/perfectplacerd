# Supabase — copy to `.env.local` and fill in from your Supabase project settings.
# Setup guide: docs/supabase-setup.md

# Project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon public key (Settings → API) — safe for browser with RLS enabled
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key — server-only; never expose to the client or commit
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: for `supabase link` (Settings → General → Reference ID)
# SUPABASE_PROJECT_REF=your-project-ref
