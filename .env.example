# Copy to `.env.local` and replace placeholders from Supabase → Settings → API.
# Production deploy: set the same vars in Vercel (Production), then redeploy.
# Guides: docs/supabase-setup.md, docs/production-deployment.md

NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=https://perfect-placer-v2.vercel.app

# Optional: override auth callback host during local dev (default http://localhost:3000)
# NEXT_PUBLIC_DEV_AUTH_URL=http://localhost:3000

# Server-only — never commit or expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Legacy alias (optional; same value as publishable key)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
